# =============================================================
# HRP environment variables (NAMES ONLY — KHÔNG điền giá trị thật vào file này)
# Xem docs/tasks/hrp-phase1-bcc-fence/TASK.md (DEC-05, RQ-06)
# =============================================================

# Prisma / database (xem .env local + Vercel dashboard)
DATABASE_URL=

# Auth (Phase 1 bcc-fence) — JWT secret >= 32 ký tự
JWT_SECRET=

# Seed tài khoản login (bcc-fence) — phone + password
ADMIN_PHONE=
ADMIN_PASSWORD=
HR_PHONE=
HR_PASSWORD=

# Marketplace rate limit phân tán (V5-OPS-06A / DEC-01/02/05)
# Upstash Redis REST là counter source-of-truth cho browse/tracking/apply.
# Production THIẾU hoặc SAI hai biến này ⇒ route trả 503 RATE_LIMIT_UNAVAILABLE
# (KHÔNG có fallback RAM). RATE_LIMIT_HASH_SECRET là pepper HMAC riêng, >= 32 ký tự,
# KHÔNG dùng lại JWT_SECRET.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SECRET=
