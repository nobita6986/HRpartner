// ═══════════════════════════════════════════════════════════════════════════
// 3. MODEL MỚI: Dependent — người phụ thuộc để giảm trừ TNCN
//    (Viet-ERP HRM line 429-444)
// ═══════════════════════════════════════════════════════════════════════════

model Dependent {
  id              String               @id @default(uuid())
  workerId        String               @map("worker_id")
  fullName        String               @map("full_name")
  dateOfBirth     DateTime             @map("date_of_birth")
  relationship    DependentRelationship
  nationalId      String?              @map("national_id")
  taxDependentCode String?             @unique @map("tax_dependent_code")
  // Mã số thuế người phụ thuộc (cấp bởi cơ quan thuế sau khi đăng ký Mẫu 07/ĐK-NPT-TNCN)

  registeredAt    DateTime?            @map("registered_at")
  validFrom       DateTime             @map("valid_from")    // từ tháng/năm được giảm trừ
  validTo         DateTime?            @map("valid_to")      // null = còn hiệu lực
  isActive        Boolean              @default(true) @map("is_active")

  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  worker          Worker               @relation("WorkerDependents", fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, isActive])
  @@index([taxDependentCode])
  @@map("dependents")
}

// ═══════════════════════════════════════════════════════════════════════════
// 4. MODEL MỚI: PayrollConfig — key-value effective-dated
//    (HRP v3.0 §12.5.1 B4 — học từ Odoo res.config_settings + Viet-ERP)
// ═══════════════════════════════════════════════════════════════════════════

model PayrollConfig {
  id            String    @id @default(uuid())

  key           String    // 'BHXH_RATE_EMPLOYEE', 'PIT_BRACKETS', ...
  valueJson     Json      @map("value_json")
  valueType     String    @map("value_type")  // 'NUMBER' | 'PERCENT' | 'MONEY' | 'BOOLEAN' | 'STRING' | 'JSON_ARRAY'

  description   String?
  legalRef      String?   @map("legal_ref")   // vd "Nghị định 74/2024/NĐ-CP, Điều 3"

  version       Int       @default(1)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")  // null = đang áp dụng
  isActive      Boolean   @default(true) @map("is_active")

  createdBy     String?   @map("created_by")
  createdByUser User?     @relation(fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([key, version])
  @@index([key, isActive, effectiveFrom])
  @@map("payroll_config")
}

// ═══════════════════════════════════════════════════════════════════════════
// 5. MODEL MỚI: TaxBracket — PIT progressive brackets (bảng riêng)
//    Tách khỏi payroll_config JSON để dễ audit, versioning, performance.
// ═══════════════════════════════════════════════════════════════════════════

model TaxBracket {
  id                String    @id @default(uuid())

  // Bậc thuế (1-7 cho VN PIT lũy tiến)
  ordinal           Int       // 1..7

  // Dải thu nhập chịu thuế (VND/tháng)
  lowerBoundVnd     BigInt    @map("lower_bound_vnd")
  upperBoundVnd     BigInt?   @map("upper_bound_vnd")  // null = không giới hạn trên

  // Thuế suất biên
  ratePercent       Decimal   @map("rate_percent") @db.Decimal(5, 2)  // 5.00, 10.00, ..., 35.00

  // Thuế lũy tiến tích lũy từ bậc trước (VND)
  cumulativeTaxVnd  BigInt    @map("cumulative_tax_vnd")

  // Áp dụng từ ngày (cho phép đổi bảng thuế khi Quốc hội sửa luật)
  effectiveFrom     DateTime  @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  isActive          Boolean   @default(true) @map("is_active")

  legalRef          String?   @map("legal_ref")  // "Luật Thuế TNCN 2007, Điều 22"

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([ordinal, effectiveFrom])
  @@index([isActive, effectiveFrom])
  @@map("tax_brackets")
}

