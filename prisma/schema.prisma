// ═══════════════════════════════════════════════════════════════════════════
// HRP — Prisma schema hợp nhất (V4 F23)
//
// Nguồn hợp nhất:
//   - UNIFIED_PLAN_v4.md §9  (Worker, Source, Assignment — 5 state machine)
//   - UNIFIED_PLAN_v4.md §10 (Contracts, Rate cards — tách vendor pay / client bill)
//   - UNIFIED_PLAN_v4.md §12 (Attendance 3 tầng, Statements, canonical statuses)
//   - schema-v3.1-patches.prisma   (VN compliance: Worker fields, Dependent, PayrollConfig, TaxBracket)
//   - schema-m7-tickets.prisma     (Ticket workflow, AuditLog)
//
// Quy ước V4:
//   - Tiền = BigInt VND nguyên (ADR-010) — cấm Decimal/float cho tiền
//   - status enum là nguồn sự thật DUY NHẤT (F3) — không có docStatus
//   - Canonical naming: cccdNumber, salaryPerDayVnd, employeeCode (ở assignment), userId (ở worker)
//   - Partial unique index (1 accepted source — Referral Guard; 1 ACTIVE assignment — G14) trong migration g22_security
//
// Wave 4 sẽ bổ sung: pay_runs, worker_pay_results, earning/deduction_lines,
// payslips, commission_policies/ledger, payroll_rules, pay_run_rule_overrides (plan §12.5, §10.3).
// workflow_definitions chỉ thêm khi cần cấu hình 3-tier theo dự án (F2).
// M9 (sau core): Ticket mở rộng actorType EMPLOYEE + employeeId nullable (F13 / V4.1 G6).
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_ADMIN")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum DependentRelationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum TicketType {
  TIMESHEET_DISPUTE // Phản ánh sai công
  ADVANCE_SALARY // Yêu cầu tạm ứng
  LEAVE_REQUEST // Xin nghỉ phép (worker) — M9 tái dùng cho employee (F13)
  OTHER
}

enum TicketStatus {
  PENDING // vừa tạo, chờ HR review
  HR_APPROVED // HR đã xác nhận (cho ADVANCE: chuyển Accountant)
  REJECTED // HR/Accountant từ chối (terminal)
  CANCELLED // Worker tự rút (chỉ khi PENDING/HR_APPROVED)
  APPROVED // Hoàn tất duyệt (cho ADVANCE: Accountant chi; cho DISPUTE: HR chốt)
  PAID // Cho ADVANCE: đã chi tiền (terminal)
  CLOSED // Ticket hoàn tất (terminal — dispute đã xử lý)
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketActorRole {
  WORKER
  HR_STAFF
  HR_MANAGER
  ACCOUNTANT
  PM
  ADMIN
}

enum TicketAction {
  CREATE
  REVIEW // HR review lần đầu
  APPROVE_HR // HR approve chuyển Accountant
  APPROVE_FINAL // Accountant approve chi
  REJECT
  CANCEL // Worker tự rút
  PAY // Accountant chi tiền — endpoint /pay riêng (F27)
  CLOSE // Đóng ticket
  COMMENT // Worker/HR comment trong ticket
}

// V4.14 G22 — 13 role (canonical docs/data-scope-security.md §3.1)
// ADMIN = ROOT: bất khả tước — resolve permission short-circuit `role = ADMIN → ALL`
// (quyền root là tiên đề, không phụ thuộc row nào — permission tạo sau tự thuộc root)
enum SystemRole {
  ADMIN
  HR_MANAGER
  DIRECTOR // Ban giám đốc — đọc toàn bộ, ghi qua Permission Pool (G22)
  HR_STAFF
  SALE
  PM
  ACCOUNTANT
  MKT // account nghiệp vụ CRM — không đọc Worker (Q#22)
  VENDOR_ADMIN
  VENDOR_STAFF
  CTV
  WORKER
  EMPLOYEE
}

enum CandidateSubmissionStatus {
  NEW
  NEEDS_INFO
  SCREENING
  QUALIFIED
  REJECTED
  WITHDRAWN
  CONVERTED
  MERGED
}

// ═══════════════════════════════════════════════════════════════════════════
// 1. USERS & AUTH (ADR-007: OTP baseline + JWT; auth_identities Wave 1)
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id           String   @id @default(uuid())
  phone        String? // V4.2: KHÔNG phải định danh — chỉ là thông tin liên hệ, đổi được
  passwordHash String?  @map("password_hash") // V4.2 (ADR-007): argon2/bcrypt — đặt lúc đăng ký
  affCode      String?  @unique @map("aff_code") // V4.5 G13 — link giới thiệu CTV/Sale (first-click wins)
  name         String?
  role         SystemRole // V4.14 G22 — enum 13 role (ADMIN = root bất khả tước §15.1)
  vendorId     String?  @map("vendor_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  candidateSubmissions CandidateSubmission[]
  sourceClaims         SourceClaim[]
  payrollConfigs       PayrollConfig[]
  permissionGrants     UserPermissionGrant[]

  // G22 — data isolation relations (§9.7 + docs/data-scope-security.md)
  ownedWorkers       Worker[]  @relation("WorkerOwner")
  assignedWorkers    Worker[]  @relation("WorkerAssignee")
  workerAccount      Worker?   @relation("WorkerAccount")
  managedProjects    Project[] @relation("ProjectPm")
  subManagedProjects1 Project[] @relation("ProjectSubPm1") // M13: phó PM thứ 1
  subManagedProjects2 Project[] @relation("ProjectSubPm2") // M13: phó PM thứ 2
  managingWorkers    Worker[]  @relation("WorkerManager")   // M13: quản lý trực tiếp worker

  @@index([role, isActive])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════
// 1b. PERMISSION POOL (V4.14 G22 — canonical docs/data-scope-security.md §4)
//     Feature Permission ≠ Data Scope — 2 trục độc lập, kiểm tra cả hai (§15.1 plan)
//     ROOT: role ADMIN short-circuit → ALL, bất khả tước; service chặn ghi nhắm ADMIN.
// ═══════════════════════════════════════════════════════════════════════════

model Permission {
  code            String             @id // 'CAN_APPROVE_PAYROLL', 'CAN_MANAGE_PERMISSIONS', ...
  group           String             @map("perm_group") // 'PAYROLL' | 'CONTRACT' | 'TICKET' | 'REFERRAL' | 'STATEMENT' | 'WORKER' | 'SYSTEM' (tránh reserved word "group")
  description     String?
  rolePermissions RolePermission[]
  userGrants      UserPermissionGrant[]

  @@map("permissions")
}

model RolePermission {
  role           SystemRole
  permissionCode String   @map("permission_code")
  grantedBy      String?  @map("granted_by")
  createdAt      DateTime @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([role, permissionCode])
  @@map("role_permissions")
}

model UserPermissionGrant {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  permissionCode String    @map("permission_code")
  grantType      String    @map("grant_type") // GRANT | REVOKE
  // G22 — root bất khả tước: service CHẶN ghi row nhắm user role ADMIN (short-circuit vẫn là chốt cuối)
  reason         String // BẮT BUỘC — audit (vì sao cấp/thu)
  grantedBy      String    @map("granted_by")
  expiresAt      DateTime? @map("expires_at") // null = vô hạn; hết hạn bỏ qua khi resolve
  createdAt      DateTime  @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionCode], references: [code])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([userId, permissionCode, grantType]) // mỗi cặp chỉ 1 row GRANT + 1 row REVOKE
  @@index([userId])
  @@map("user_permission_grants")
}

// TODO Wave 1: model AuthIdentity — provider PHONE | ZALO | CREDENTIAL (CCCD), providerId, accountId (ADR-007 + G9)

// ═══════════════════════════════════════════════════════════════════════════
// 2. WORKER — CHỈ master data (plan v4 §9.2 + VN compliance patch v3.1)
//    source/employment/workSetting KHÔNG nằm ở đây (F15: source_claims + assignment)
// ═══════════════════════════════════════════════════════════════════════════

model Worker {
  id        String @id @default(uuid())
  userId    String @unique @map("user_id") // "USR-001" — Primary UserID, tạo khi đăng ký, KHÔNG đổi (F16)
  fullName  String? @map("full_name")
  phone     String? @unique // V4.2: liên hệ (đổi được) — KHÔNG phải định danh; unique chỉ để gợi ý dedup
  cccdNumber String? @unique @map("cccd_number") // F17 (chuẩn: cccdNumber, không dùng nationalId)
  cccdImageUrl String? @map("cccd_image_url")
  selfieImageUrl String? @map("selfie_image_url")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender    Gender?
  maritalStatus MaritalStatus? @map("marital_status")

  // VN compliance (patch v3.1 — C1/C2/C3)
  permanentAddress String? @map("permanent_address")
  currentAddress   String? @map("current_address")
  hometown         String?
  ethnicGroup      String? @map("ethnic_group")
  religion         String?
  nationality      String  @default("VN")
  cccdIssuedDate   DateTime? @map("cccd_issued_date") @db.Date
  cccdIssuedPlace  String? @map("cccd_issued_place")
  cccdExpiryDate   DateTime? @map("cccd_expiry_date") @db.Date
  cccdChipData     Json? @map("cccd_chip_data") // dữ liệu chip NFC (eKYC — hoãn, post-go-live)
  taxCode          String? @unique @map("tax_code")
  insuranceCode    String? @unique @map("insurance_code")
  bankAccount      String? @map("bank_account")
  bankName         String? @map("bank_name")
  bankBranch       String? @map("bank_branch")

  // 5 state machine (v4 §9.1 — canonical, F15)
  profileStatus    String @default("INCOMPLETE") @map("profile_status") // INCOMPLETE | PENDING_VERIFY | VERIFIED | REJECTED
  employmentStatus String @default("NONE") @map("employment_status") // NONE | ACTIVE | SUSPENDED | TERMINATED
  riskStatus       String @default("NORMAL") @map("risk_status") // NORMAL | REVIEW | BLOCKED

  // CRM ownership (data isolation §9.7 — canonical docs/data-scope-security.md)
  ownerId      String? @map("owner_id")
  assignedToId String? @map("assigned_to_id")
  accountUserId String? @unique @map("account_user_id") // V4.14 G22 — link tài khoản đăng nhập (role WORKER) ↔ hồ sơ lao động; scope WORKER dùng field này
  managerId    String? @map("manager_id") // M13: quản lý trực tiếp (User.id) — phục vụ filter + scope UI về sau

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dependents  Dependent[] @relation("WorkerDependents")
  tickets     Ticket[]
  assignments ProjectAssignment[]
  sourceClaims      SourceClaim[]
  submissions       CandidateSubmission[] @relation("ConvertedWorkerSubmissions")
  mergedSubmissions CandidateSubmission[] @relation("MergedWorkerSubmissions")

  // G22 — FK chủ sở hữu (thay String thô, giữ nguyên tên cột owner_id/assigned_to_id)
  owner      User? @relation("WorkerOwner", fields: [ownerId], references: [id])
  assignedTo User? @relation("WorkerAssignee", fields: [assignedToId], references: [id])
  account    User? @relation("WorkerAccount", fields: [accountUserId], references: [id])
  manager    User? @relation("WorkerManager", fields: [managerId], references: [id]) // M13

  @@index([profileStatus, employmentStatus])
  @@index([ownerId, assignedToId])
  @@index([managerId]) // M13 — filter theo manager
  @@map("workers")
}

model Dependent {
  id              String   @id @default(uuid())
  workerId        String   @map("worker_id")
  fullName        String   @map("full_name")
  dateOfBirth     DateTime @map("date_of_birth") @db.Date
  relationship    DependentRelationship
  nationalId      String?  @map("national_id")
  taxDependentCode String? @unique @map("tax_dependent_code") // MST NPT (Mẫu 07/ĐK-NPT-TNCN)
  registeredAt    DateTime? @map("registered_at")
  validFrom       DateTime @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date // null = còn hiệu lực
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  worker Worker @relation("WorkerDependents", fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, isActive])
  @@map("dependents")
}

// ═══════════════════════════════════════════════════════════════════════════
// 3. CRM — Client, Lead, Project, Staffing Order (plan v4 §9, ERD tầng 1-3)
// ═══════════════════════════════════════════════════════════════════════════

model ClientCompany {
  id          String   @id @default(uuid())
  code        String   @unique // "CC-001"
  name        String
  taxCode     String?  @unique @map("tax_code") // MST công ty
  industry    String?
  companySize String?  @map("company_size") // SMALL | MEDIUM | LARGE | ENTERPRISE
  status      String   @default("PROSPECT") // PROSPECT | ACTIVE | BLACKLISTED
  createdAt   DateTime @default(now()) @map("created_at")

  projects Project[]
  leads    CrmLead[]

  @@map("client_companies")
}

model CrmLead {
  id               String    @id @default(uuid())
  name             String
  clientCompanyId  String?   @map("client_company_id")
  contactName      String?   @map("contact_name")
  contactPhone     String?   @map("contact_phone")
  expectedRevenueVnd BigInt? @map("expected_revenue_vnd") // V4: BigInt VND nguyên (ADR-010)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  stage            String    @default("NEW") // NEW | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  probability      Int       @default(10) // 0-100
  ownerUserId      String?   @map("owner_user_id")
  convertedProjectId String? @map("converted_project_id")
  convertedAt      DateTime? @map("converted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  clientCompany ClientCompany? @relation(fields: [clientCompanyId], references: [id])

  @@index([stage])
  @@map("crm_leads")
}

model Project {
  id              String   @id @default(uuid())
  code            String   @unique // "PRJ-2025-001"
  clientCompanyId String   @map("client_company_id")
  name            String
  pmUserId        String?  @map("pm_user_id") // Project Manager (chính)
  subPmUserId1    String?  @map("sub_pm_user_id_1") // M13: phó PM thứ 1 — quan hệ tới users.id
  subPmUserId2    String?  @map("sub_pm_user_id_2") // M13: phó PM thứ 2 — quan hệ tới users.id
  siteAddress     String?  @map("site_address")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  status          String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED | CANCELLED
  budgetVnd       BigInt?  @map("budget_vnd") // V4: BigInt VND nguyên (ADR-010)
  billingTerms    Json?    @map("billing_terms") // { type: 'monthly', dayOfMonth: 5 }
  quota           Int      @default(0) // quota tuyển (14.4 — OCC qua version)
  filled          Int      @default(0) // V4: luôn cùng transaction với assignment (9.9)
  version         Int      @default(1)
  isPublic        Boolean  @default(false) @map("is_public") // job board (A-04)
  createdAt       DateTime @default(now()) @map("created_at")

  clientCompany  ClientCompany   @relation(fields: [clientCompanyId], references: [id])
  assignments    ProjectAssignment[]
  staffingOrders StaffingOrder[]
  submissions    CandidateSubmission[]
  sites          Site[]
  pmUser         User?           @relation("ProjectPm", fields: [pmUserId], references: [id]) // G22
  subPm1         User?           @relation("ProjectSubPm1", fields: [subPmUserId1], references: [id]) // M13
  subPm2         User?           @relation("ProjectSubPm2", fields: [subPmUserId2], references: [id]) // M13

  @@index([status, isPublic])
  @@index([pmUserId, status]) // G22 — scope PM (relation filter §9.7)
  @@index([subPmUserId1])     // M13 — scope sub-PM thứ 1
  @@index([subPmUserId2])     // M13 — scope sub-PM thứ 2
  @@map("outsourcing_projects") // ERD DDL dùng tên này; plan §9 SQL mẫu dùng "projects" — DB thật là outsourcing_projects
}

model StaffingOrder {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  code         String   @unique // "SO-001"
  title        String
  description  String?
  deadlineDate DateTime? @map("deadline_date") @db.Date
  status       String   @default("OPEN") // OPEN | CLOSING_SOON | CLOSED | CANCELLED
  createdAt    DateTime @default(now()) @map("created_at")

  project     Project             @relation(fields: [projectId], references: [id])
  slots       StaffingOrderSlot[]
  assignments ProjectAssignment[]

  @@index([projectId, status])
  @@map("staffing_orders")
}

model StaffingOrderSlot {
  id             String   @id @default(uuid())
  staffingOrderId String  @map("staffing_order_id")
  positionCode   String   @map("position_code") // 'ELECTRICIAN'
  positionTitle  String   @map("position_title")
  slotsNeeded    Int      @map("slots_needed")
  slotsFilled    Int      @default(0) @map("slots_filled") // denormalized (O9) — update trong transaction
  hourlyRateVnd  BigInt?  @map("hourly_rate_vnd") // V4: BigInt VND nguyên
  shiftStart     String?  @map("shift_start") // "07:00"
  shiftEnd       String?  @map("shift_end") // "16:00"
  validFrom      DateTime @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  workLocation   String?  @map("work_location")
  createdAt      DateTime @default(now()) @map("created_at")

  staffingOrder StaffingOrder @relation(fields: [staffingOrderId], references: [id], onDelete: Cascade)
  submissions   CandidateSubmission[] // MP-2 RQ-01: applications linked to this slot
  assignments   ProjectAssignment[]   // MP-3C RQ-01: placements filling this slot

  @@index([staffingOrderId, validFrom])
  @@map("staffing_order_slots")
}

// ═══════════════════════════════════════════════════════════════════════════
// 3b. SITE — địa điểm làm việc (V4.2 Q2 đã chốt: geofence + rate theo site)
// ═══════════════════════════════════════════════════════════════════════════

model Site {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  name          String
  address       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  radiusMeters  Int      @default(200) @map("radius_meters") // geofence default 200m [CẦN CHỐT theo site]
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("sites")
}

// ═══════════════════════════════════════════════════════════════════════════
// 4. NGUỒN TUYỂN — Submission + SourceClaim (plan v4 §9.3, ADR-012)
// ═══════════════════════════════════════════════════════════════════════════

model Vendor {
  id        String   @id @default(uuid())
  code      String   @unique // "VD-001"
  name      String
  taxCode   String?  @unique @map("tax_code")
  phone     String?
  email     String?
  area      String?
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now()) @map("created_at")

  submissions  CandidateSubmission[]
  sourceClaims SourceClaim[]

  @@map("vendors")
}

model CandidateSubmission {
  id            String   @id @default(uuid())
  vendorId      String?  @map("vendor_id")
  ctvId         String?  @map("ctv_id")
  projectId     String?  @map("project_id")
  fullName      String   @map("full_name")
  phone         String
  cccdNumber    String?  @map("cccd_number") // F17
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?
  experience    String?
  cccdImageUrl  String?  @map("cccd_image_url")
  status        CandidateSubmissionStatus @default(NEW)
  workerId       String? @map("worker_id") // MP-3: canonical converted Worker link
  mergedWorkerId String? @map("merged_worker_id")
  dedupWorkerId  String?  @map("dedup_worker_id") // V4.3 G11: worker trùng CCCD đã tồn tại (Referral Guard §9.3.1)
  blockCode      String?  @map("block_code") // V4.3: IN_7D_WINDOW | COMMISSION_ACTIVE | VENDOR_PAYROLL_ACTIVE
  overrideCase   String?  @map("override_case") // V4.4 G12: S1 | S2 | S3 (SOP override §9.3.1)
  reviewedBy    String?  @map("reviewed_by")
  reviewNote    String?  @map("review_note")
  version       Int      @default(0) // MP-3 optimistic transition guard
  // ── MP-2 Apply + Tracking (additive, nullable/backfill-safe) ──────────────
  slotId                 String?   @map("slot_id")                  // MP-2 RQ-01: linked StaffingOrderSlot
  publicTrackingCode     String?   @unique @map("public_tracking_code") // MP-2 RQ-01/4.3: high-entropy public code
  normalizedPhone        String?   @map("normalized_phone")         // MP-2 DEC-04: duplicate-guard key
  idempotencyKeyHash     String?   @unique @map("idempotency_key_hash")     // MP-2 DEC-03: sha256(client key)
  idempotencyPayloadHash String?   @map("idempotency_payload_hash") // MP-2 DEC-03: sha256(canonical payload)
  consentAt              DateTime? @map("consent_at")               // MP-2 RQ-02: applicant consent timestamp
  cvStorageKey           String?   @map("cv_storage_key")           // MP-2 DEC-07: optional CV storage key (adapter deferred)
  cvFileName             String?   @map("cv_file_name")             // MP-2 DEC-07: CV metadata only
  cvMimeType             String?   @map("cv_mime_type")             // MP-2 DEC-07: PDF/JPEG/PNG allow-list
  cvSizeBytes            Int?      @map("cv_size_bytes")            // MP-2 DEC-07: max 5 MiB
  createdAt     DateTime @default(now()) @map("created_at")

  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  ctv           User?    @relation(fields: [ctvId], references: [id])
  project       Project? @relation(fields: [projectId], references: [id])
  worker        Worker?  @relation("ConvertedWorkerSubmissions", fields: [workerId], references: [id])
  mergedWorker  Worker?  @relation("MergedWorkerSubmissions", fields: [mergedWorkerId], references: [id])
  slot          StaffingOrderSlot? @relation(fields: [slotId], references: [id]) // MP-2 RQ-01
  sourceClaims  SourceClaim[]
  statusHistory ApplicationStatusHistory[] // MP-2 RQ-01/RQ-06
  assignment    ProjectAssignment? // MP-3C RQ-01: at most one initial placement per submission

  @@index([vendorId, phone]) // V4.5 G13: bỏ unique để nộp LẠI cùng người cho nhu cầu khác — chống trùng bằng Referral Guard
  @@index([cccdNumber]) // V4.3 G11: Referral Guard tra cứu nhanh theo CCCD
  @@index([workerId]) // MP-3 conversion lookup
  @@index([status])
  @@index([slotId, normalizedPhone]) // MP-2 DEC-04: duplicate-guard lookup (partial-unique backstop lives in migration SQL)
  @@map("candidate_submissions")
}

// ═══════════════════════════════════════════════════════════════════════════
// 4b. APPLICATION STATUS HISTORY — MP-2 (RQ-01/RQ-06, DEC-05). Append-only.
// ═══════════════════════════════════════════════════════════════════════════

model ApplicationStatusHistory {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  fromStatus   String?  @map("from_status")
  toStatus     String   @map("to_status")
  actorUserId  String?  @map("actor_user_id") // NULL for anonymous public apply
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  submission CandidateSubmission @relation(fields: [submissionId], references: [id])

  @@index([submissionId, createdAt])
  @@map("application_status_history")
}

model SourceClaim {
  id                 String   @id @default(uuid())
  workerId           String   @map("worker_id")
  claimType          String   @map("claim_type") // HRP_DIRECT | VENDOR_SUPPLIED | CTV_REFERRAL
  vendorId           String?  @map("vendor_id")
  ctvId              String?  @map("ctv_id")
  submissionId       String?  @map("submission_id")
  registrationChannel String @default("SALE_ADDED") @map("registration_channel")
  // SELF_REGISTER | SALE_ADDED | HR_ADDED | VENDOR_ADDED | CTV_ADDED | AFF_CTV | AFF_SALE (V4.5)
  accepted           Boolean  @default(false) // DUY NHẤT 1 claim accepted / worker (partial unique index qua migration)
  acceptedBy         String?  @map("accepted_by")
  claimedBy          String?  @map("claimed_by")
  createdAt          DateTime @default(now()) @map("created_at")

  worker     Worker              @relation(fields: [workerId], references: [id])
  vendor     Vendor?             @relation(fields: [vendorId], references: [id])
  ctv        User?               @relation(fields: [ctvId], references: [id])
  submission CandidateSubmission? @relation(fields: [submissionId], references: [id])

  @@index([workerId, accepted])
  @@index([vendorId, accepted]) // G22 — scope VENDOR (relation filter §9.7)
  @@index([ctvId, accepted]) // G22 — scope CTV (relation filter §9.7)
  @@map("source_claims")
}

// ═══════════════════════════════════════════════════════════════════════════
// 5. ASSIGNMENT — employmentType/workSetting ở đây, half-open, đa assignment (v4 §9.4)
// ═══════════════════════════════════════════════════════════════════════════

model ProjectAssignment {
  id             String    @id @default(uuid())
  workerId       String    @map("worker_id")
  projectId      String    @map("project_id")
  staffingOrderId String?  @map("staffing_order_id")
  employeeCode   String    @map("employee_code") // mã NV tại dự án — Secondary UserID (F16)
  employmentType String    @map("employment_type") // HRP_EMPLOYED | OUTSOURCED | REFERRED_OUT
  workSetting    String?   @map("work_setting") // PHOTHONG | VANPHONG | CONGXUONG (nếu HRP_EMPLOYED)
  validFrom      DateTime  @map("valid_from") @db.Timestamptz(3) // V4.9 G17 (T3): TIMESTAMP — chuyển GIỮA CA trong ngày; nửa mở [from, to)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(3)
  status         String    @default("PLANNED") // PLANNED | ACTIVE | PAUSED | ENDED | TRANSFERRED | CANCELLED
  isPrimary      Boolean   @default(true) @map("is_primary") // G14: luôn true khi ACTIVE — 1 người chỉ 1 dự án tại 1 thời điểm (giữ cho tương lai)
  managerId      String?   @map("manager_id")
  referrerId     String?   @map("referrer_id")
  salaryPerDayVnd BigInt   @default(0) @map("salary_per_day_vnd") // F18 — BigInt VND nguyên (ADR-010)
  salaryType     String   @default("DAILY") @map("salary_type") // V4.9 G17 (B3): DAILY | MONTHLY (proration khối văn phòng)
  salaryMonthVnd BigInt?  @map("salary_month_vnd") // V4.9: lương tháng cho MONTHLY
  transferReason String?   @map("transfer_reason")
  // ── MP-3C Assignment placement (additive, nullable/backfill-safe — DEC-02) ──
  // Legacy rows (incl. every transfer-created assignment) keep both NULL: only a
  // Marketplace placement that starts from a CONVERTED submission fills them.
  submissionId        String? @unique @map("submission_id")          // MP-3C RQ-01: canonical source submission — one initial assignment per submission
  staffingOrderSlotId String? @map("staffing_order_slot_id")         // MP-3C RQ-01: the slot this assignment fills (slotsFilled projection source)
  createdAt      DateTime  @default(now()) @map("created_at")

  worker        Worker        @relation(fields: [workerId], references: [id])
  project       Project       @relation(fields: [projectId], references: [id])
  staffingOrder StaffingOrder? @relation(fields: [staffingOrderId], references: [id])
  submission        CandidateSubmission? @relation(fields: [submissionId], references: [id])        // MP-3C
  staffingOrderSlot StaffingOrderSlot?   @relation(fields: [staffingOrderSlotId], references: [id]) // MP-3C
  tickets       Ticket[]

  @@unique([projectId, employeeCode])
  @@index([workerId, status])
  @@index([projectId, status]) // G22 — scope PM (relation filter §9.7)
  @@index([staffingOrderSlotId, status]) // MP-3C: slotsFilled ↔ ACTIVE assignment reconciliation
  @@map("project_assignments")
}

// ═══════════════════════════════════════════════════════════════════════════
// 6. CHẤM CÔNG 3 TẦNG (v4 §12.2 — canonical, F2/F19/F6)
// ═══════════════════════════════════════════════════════════════════════════

model AttendanceImportBatch {
  id               String    @id @default(uuid())
  uploadedByActorId String   @map("uploaded_by_actor_id")
  uploadedByRole   String    @map("uploaded_by_role")
  source           String // 'CSV' | 'XLSX' (PDF chỉ là attachment — 12.1)
  fileUrl          String    @map("file_url") // R2 (ADR-006)
  fileHash         String    @map("file_hash") // SHA-256 — chống import trùng
  totalRows        Int       @map("total_rows")
  matchedRows      Int       @default(0) @map("matched_rows")
  unmatchedRows    Int       @default(0) @map("unmatched_rows")
  anomalyRows      Int       @default(0) @map("anomaly_rows")
  status           String    @default("PENDING") // PENDING | PREVIEWED | COMMITTED | FAILED
  errors           Json      @default("[]")
  startedAt        DateTime  @default(now()) @map("started_at")
  updatedAt        DateTime  @updatedAt @map("updated_at") // V4.12 G20-T11: heartbeat cho watchdog
  retryCount       Int       @default(0) @map("retry_count") // V4.13 G21-T15: quá IMPORT_MAX_RETRY → FAILED cứng
  completedAt      DateTime? @map("completed_at")

  rawRows AttendanceImportRow[]

  @@index([status, startedAt])
  @@map("attendance_import_batches")
}

model AttendanceImportRow {
  id              String    @id @default(uuid())
  batchId         String    @map("batch_id")
  rowNumber       Int       @map("row_number")
  rawEmployeeCode String    @map("raw_employee_code")
  rawDate         String    @map("raw_date")
  rawTime         String    @map("raw_time")
  rawType         String    @map("raw_type") // 'IN' | 'OUT'
  parsedDate      DateTime? @map("parsed_date") @db.Date
  parsedTime      String?   @map("parsed_time")
  matchedWorkerId String?   @map("matched_worker_id")
  anomalyType     String?   @map("anomaly_type") // MISSING_CHECKOUT | INVALID_CODE | DUPLICATE_SCAN | OUTSIDE_SHIFT | INVALID_DATE
  anomalyNote     String?   @map("anomaly_note")
  status          String    @default("PENDING") // PENDING | MATCHED | UNMATCHED | ANOMALY | COMMITTED

  batch AttendanceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber]) // V4.11 G19-T9: idempotent tuyệt đối — chống zombie job parse đúp
  @@index([batchId, status])
  @@map("attendance_import_rows")
}

model ImportTemplate {
  id            String   @id @default(uuid())
  partnerName   String   @map("partner_name")
  columnMapping Json     @map("column_mapping") // { employeeCode: 'Mã NV', date: 'Ngày', in: 'Vào', out: 'Ra', ... }
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("import_templates")
}

// Lịch ngày lễ — chuẩn cho tách ca vắt ngày (V4.11 G19-B8)
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date // ngày lễ (lịch VN — §14.8)
  name      String
  type      String   @default("PUBLIC_HOLIDAY") // PUBLIC_HOLIDAY | WEEKEND | COMPANY_HOLIDAY
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

// Khấu trừ cuối khi chấm dứt (V4.12 G20-B11 — AWOL ôm tài sản/phạt hợp đồng)
model WorkerDeduction {
  id        String   @id @default(uuid())
  workerId  String   @map("worker_id")
  amountVnd BigInt   @map("amount_vnd") // VND nguyên (ADR-010)
  reason    String
  status    String   @default("PENDING") // PENDING | APPLIED | CANCELLED
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([workerId, status])
  @@map("worker_deductions")
}

model AttendanceEvent {
  id              String    @id @default(uuid())
  externalEventId String    @map("external_event_id")
  source          String // IMPORTED | MACHINE | GPS | MANUAL
  status          String    @default("APPENDED") // V4.13 G21-T14: QUEUED | APPENDED | FAILED (write-behind check-in)
  workerId        String?   @map("worker_id")
  projectId       String?   @map("project_id")
  assignmentId    String?   @map("assignment_id")
  workDate        DateTime  @map("work_date") @db.Date
  checkInTime     String?   @map("check_in_time")
  checkOutTime    String?   @map("check_out_time")
  shiftCode       String?   @map("shift_code") // nhiều ca
  payloadHash     String    @map("payload_hash")
  capturedAt      DateTime? @map("captured_at") // thời điểm tại nguồn (thiết bị/máy)
  receivedAt      DateTime  @default(now()) @map("received_at") // thời điểm server nhận — risk flag nếu lệch > 15'
  importBatchId   String?   @map("import_batch_id")
  // GPS evidence (P1 portals — DEC-03)
  gpsLatitude     Decimal?  @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude    Decimal?  @map("gps_longitude") @db.Decimal(10, 7)
  gpsAccuracyMeters Int?   @map("gps_accuracy_meters")
  geofenceResult  String?   @map("geofence_result") // INSIDE | OUTSIDE | NONE
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([source, externalEventId]) // re-import idempotent
  @@index([workerId, workDate])
  @@map("attendance_events")
}

model TimesheetPeriod {
  id         String    @id @default(uuid())
  projectId  String?   @map("project_id") // null = all projects
  month      Int
  year       Int
  status     String    @default("PENDING") // PENDING | REVIEWED | APPROVED | LOCKED (F2 — canonical)
  version    Int       @default(1) // mở lại sau LOCKED → version mới (F21)
  approvedBy String?   @map("approved_by")
  lockedAt   DateTime? @map("locked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  lines TimesheetLine[]

  @@unique([projectId, month, year, version])
  @@map("timesheet_periods")
}

model TimesheetLine {
  id           String    @id @default(uuid())
  periodId     String    @map("period_id")
  workerId     String    @map("worker_id")
  projectId    String    @map("project_id")
  assignmentId String?   @map("assignment_id")
  workDate     DateTime  @map("work_date") @db.Date
  shiftCode    String?   @map("shift_code")
  regularHours Decimal   @default(0) @map("regular_hours") @db.Decimal(5, 2)
  ot15Hours    Decimal   @default(0) @map("ot15_hours") @db.Decimal(5, 2) // ×1.5
  ot20Hours    Decimal   @default(0) @map("ot20_hours") @db.Decimal(5, 2) // ×2.0
  ot30Hours    Decimal   @default(0) @map("ot30_hours") @db.Decimal(5, 2) // ×3.0
  allowance    Json? // phụ cấp (F19 canonical)
  exception    Json? // ngoại lệ đã xử lý
  source       String    @default("MANUAL") // DEVICE | GPS_SELFIE | MANUAL | ADJUSTMENT (O7)
  anomalyType  String?   @map("anomaly_type") // O8
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")

  period TimesheetPeriod @relation(fields: [periodId], references: [id])

  @@index([workerId, workDate])
  @@map("timesheet_lines")
}

model TimesheetAdjustment {
  id         String   @id @default(uuid())
  periodId   String   @map("period_id")
  workerId   String   @map("worker_id")
  workDate   DateTime? @map("work_date") @db.Date
  deltaHours Decimal  @map("delta_hours") @db.Decimal(5, 2)
  reason     String
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("timesheet_adjustments")
}

// ═══════════════════════════════════════════════════════════════════════════
// 7. HỢP ĐỒNG & RATE CARD (v4 §10 — tách vendor pay / client bill)
// ═══════════════════════════════════════════════════════════════════════════

model Contract {
  id         String    @id @default(uuid())
  contractNo String    @map("contract_no")
  type       String // WORKER_LABOR | CLIENT_SUPPLY | VENDOR_FRAMEWORK
  projectId  String?   @map("project_id")
  signDate   DateTime? @map("sign_date") @db.Date
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  status     String    @default("DRAFT") // DRAFT | ACTIVE | EXPIRED | TERMINATED
  fileUrl    String?   @map("file_url") // R2
  version    Int       @default(1) // annex/phụ lục = version mới
  parentId   String?   @map("parent_id")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  parties     ContractParty[]
  vendorRates VendorRateCard[]
  clientRates ClientRateCard[]

  @@map("contracts")
}

model ContractParty {
  id         String @id @default(uuid())
  contractId String @map("contract_id")
  partyType  String @map("party_type") // CLIENT | VENDOR | WORKER | LEGAL_ENTITY
  partyId    String @map("party_id")
  role       String @default("PARTY") // PARTY | GUARANTOR | ...

  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([contractId, partyType, partyId])
  @@map("contract_parties")
}

model VendorRateCard {
  id            String    @id @default(uuid())
  contractId    String    @map("contract_id")
  rateType      String    @map("rate_type") // HOURLY | DAILY | MONTHLY | PER_HEAD
  price         BigInt // VND nguyên (ADR-010)
  workType      String?   @map("work_type") // PHOTHONG | VANPHONG | CONGXUONG | theo vị trí
  siteId        String?   @map("site_id") // → sites.id (V4.2 Q2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("vendor_rate_cards")
}

model ClientRateCard {
  id            String    @id @default(uuid())
  contractId    String    @map("contract_id")
  rateType      String    @map("rate_type")
  price         BigInt // VND nguyên (ADR-010)
  workType      String?   @map("work_type")
  siteId        String?   @map("site_id") // → sites.id (V4.2 Q2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("client_rate_cards")
}

// ═══════════════════════════════════════════════════════════════════════════
// 8. STATEMENTS — 2 luồng độc lập (v4 §12.6) — DRAFT→SENT→DISPUTED→CONFIRMED→LOCKED→PAID
// ═══════════════════════════════════════════════════════════════════════════

model VendorStatement {
  id          String    @id @default(uuid())
  vendorId    String    @map("vendor_id")
  periodMonth Int       @map("period_month")
  periodYear  Int       @map("period_year")
  totalAmount BigInt    @default(0) @map("total_amount")
  status      String    @default("DRAFT") // DRAFT | SENT | DISPUTED | CONFIRMED | LOCKED | PAID
  version     Int       @default(1)
  sentAt      DateTime? @map("sent_at")
  lockedAt    DateTime? @map("locked_at")
  disputeCount Int      @default(0) @map("dispute_count") // V4.9 G17 (B1): tối đa 2 vòng
  confirmDeadlineAt DateTime? @map("confirm_deadline_at") // V4.9: SLA 3 ngày → AUTO-CONFIRMED
  createdAt   DateTime  @default(now()) @map("created_at")

  lines VendorStatementLine[]

  @@unique([vendorId, periodMonth, periodYear, version])
  @@map("vendor_statements")
}

model VendorStatementLine {
  id           String  @id @default(uuid())
  statementId  String  @map("statement_id")
  workerId     String  @map("worker_id")
  assignmentId String? @map("assignment_id")
  totalHours   Decimal @map("total_hours") @db.Decimal(8, 2)
  rate         BigInt // rate version tại thời điểm công
  amount       BigInt

  statement VendorStatement @relation(fields: [statementId], references: [id])

  @@map("vendor_statement_lines")
}

model ClientStatement {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  periodMonth Int       @map("period_month")
  periodYear  Int       @map("period_year")
  totalAmount BigInt    @default(0) @map("total_amount")
  status      String    @default("DRAFT")
  version     Int       @default(1)
  sentAt      DateTime? @map("sent_at")
  lockedAt    DateTime? @map("locked_at")
  disputeCount Int      @default(0) @map("dispute_count") // V4.9 G17 (B1)
  confirmDeadlineAt DateTime? @map("confirm_deadline_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  lines ClientStatementLine[]

  @@unique([clientId, periodMonth, periodYear, version])
  @@map("client_statements")
}

model ClientStatementLine {
  id           String  @id @default(uuid())
  statementId  String  @map("statement_id")
  workerId     String  @map("worker_id")
  assignmentId String? @map("assignment_id")
  totalHours   Decimal @map("total_hours") @db.Decimal(8, 2)
  rate         BigInt
  amount       BigInt

  statement ClientStatement @relation(fields: [statementId], references: [id])

  @@map("client_statement_lines")
}

// ═══════════════════════════════════════════════════════════════════════════
// 9. PAYROLL CONFIG & TAX (patch v3.1 — F11/F12/F25)
// ═══════════════════════════════════════════════════════════════════════════

model PayrollConfig {
  id            String    @id @default(uuid())
  key           String // 'BHXH_RATE_EMPLOYEE', 'MIN_WAGE_REGION_1', ... (F11)
  valueJson     Json      @map("value_json")
  valueType     String    @map("value_type") // NUMBER | PERCENT ("0.08") | MULTIPLIER ("1.5") | MONEY | BOOLEAN | STRING (F12)
  description   String?
  legalRef      String?   @map("legal_ref") // "Nghị định 74/2024/NĐ-CP, Điều 3"
  version       Int       @default(1)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdByUser User? @relation(fields: [createdBy], references: [id])

  @@unique([key, version])
  @@index([key, isActive, effectiveFrom])
  @@map("payroll_config")
}

model TaxBracket {
  id               String    @id @default(uuid())
  ordinal          Int // 1..7
  lowerBoundVnd    BigInt    @map("lower_bound_vnd")
  upperBoundVnd    BigInt?   @map("upper_bound_vnd") // null = không giới hạn trên
  ratePercent      Decimal   @map("rate_percent") @db.Decimal(5, 2) // 5.00 .. 35.00
  cumulativeTaxVnd BigInt    @map("cumulative_tax_vnd")
  effectiveFrom    DateTime  @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  isActive         Boolean   @default(true) @map("is_active")
  legalRef         String?   @map("legal_ref")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([ordinal, effectiveFrom])
  @@index([isActive, effectiveFrom])
  @@map("tax_brackets")
}

// ═══════════════════════════════════════════════════════════════════════════
// 10. TICKET (schema-m7 — state machine 7 status × 8 action, ADR-014)
// ═══════════════════════════════════════════════════════════════════════════

model Ticket {
  id              String          @id @default(uuid())
  type            TicketType
  status          TicketStatus    @default(PENDING)
  priority        TicketPriority  @default(NORMAL)

  workerId        String          @map("worker_id")
  worker          Worker          @relation(fields: [workerId], references: [id])
  createdByActorId String         @map("created_by_actor_id") // user tạo (worker, hoặc HR tạo hộ)
  createdByRole   TicketActorRole @map("created_by_role")
  createdAt       DateTime        @default(now()) @map("created_at")

  assignmentId    String?         @map("assignment_id")
  assignment      ProjectAssignment? @relation(fields: [assignmentId], references: [id])

  workDate        DateTime?       @map("work_date") @db.Date
  currentHours    Decimal?        @map("current_hours") @db.Decimal(5, 2)
  requestedHours  Decimal?        @map("requested_hours") @db.Decimal(5, 2)
  deltaHours      Decimal?        @map("delta_hours") @db.Decimal(5, 2)
  reasonCode      String?         @map("reason_code") // 'MISSING_CHECKOUT', 'SHIFT_MISMATCH', 'MACHINE_ERROR', ...

  amountVnd       BigInt          @default(0) @map("amount_vnd") // ADR-010
  requestedPayDate DateTime?      @map("requested_pay_date") @db.Date
  deductMonth     Int?            @map("deduct_month")
  deductYear      Int?            @map("deduct_year")
  deductionVnd    BigInt          @default(0) @map("deduction_vnd")

  leaveFromDate   DateTime?       @map("leave_from_date") @db.Date
  leaveToDate     DateTime?       @map("leave_to_date") @db.Date
  leaveDays       Decimal?        @map("leave_days") @db.Decimal(4, 1)
  leaveTypeCode   String?         @map("leave_type_code") // 'ANNUAL', 'SICK', 'UNPAID', 'MATERNITY'

  title           String
  description     String          @db.Text
  metadata        Json?           @default("{}")

  slaDueAt        DateTime?       @map("sla_due_at")
  isOverdue       Boolean         @default(false) @map("is_overdue")

  version         Int             @default(1) // optimistic locking

  history         TicketHistory[]
  comments        TicketComment[]
  notifications   TicketNotification[]

  @@index([type, status])
  @@index([workerId, status])
  @@index([status, priority, createdAt])
  @@index([slaDueAt])
  @@map("tickets")
}

model TicketHistory {
  id             String          @id @default(uuid())
  ticketId       String          @map("ticket_id")
  ticket         Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  action         TicketAction
  fromStatus     TicketStatus?   @map("from_status")
  toStatus       TicketStatus    @map("to_status")

  actorId        String?         @map("actor_id") // null cho system
  actorRole      TicketActorRole @map("actor_role")
  actorName      String?         @map("actor_name") // denormalized cho audit

  note           String?         @db.Text
  payload        Json?           @default("{}")
  ipAddress      String?         @map("ip_address")
  userAgent      String?         @map("user_agent")

  idempotencyKey String?         @map("idempotency_key")

  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_history")
}

model TicketComment {
  id         String          @id @default(uuid())
  ticketId   String          @map("ticket_id")
  ticket     Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId   String          @map("author_id")
  authorRole TicketActorRole @map("author_role")
  authorName String          @map("author_name")

  body       String          @db.Text
  isInternal Boolean         @default(false) @map("is_internal") // true = chỉ HR

  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketNotification {
  id            String          @id @default(uuid())
  ticketId      String          @map("ticket_id")
  ticket        Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  recipientId   String          @map("recipient_id")
  recipientRole TicketActorRole @map("recipient_role")

  channel       String          @default("IN_APP") // 'IN_APP' | 'EMAIL' | 'SMS' | 'ZALO'
  status        String          @default("PENDING") // 'PENDING' | 'SENT' | 'FAILED' | 'READ'
  retryCount    Int             @default(0) @map("retry_count")
  failureReason String?         @map("failure_reason")

  subject       String
  body          String          @db.Text
  linkUrl       String?         @map("link_url")
  payload       Json?           @default("{}")

  scheduledAt   DateTime        @default(now()) @map("scheduled_at")
  sentAt        DateTime?       @map("sent_at")
  readAt        DateTime?       @map("read_at")

  @@index([status, scheduledAt])
  @@index([recipientId, status])
  @@map("ticket_notifications")
}

// ═══════════════════════════════════════════════════════════════════════════
// 11. AUDIT LOG (ADR-014 — mọi entity)
// ═══════════════════════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  entityType String   @map("entity_type") // 'Ticket' | 'Attendance' | 'PayRun' | 'Statement' | ...
  entityId   String   @map("entity_id")
  action     String // 'CREATE' | 'UPDATE' | 'DELETE' | 'STATE_TRANSITION' | ...
  diff       Json?    @default("{}")
  metadata   Json?    @default("{}")
  // Phase 3 / RQ-03 — DEC-03: chuẩn hóa 3 cột nullable; dữ liệu cũ giữ nguyên.
  reason     String?  @db.Text
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// 12. INTEGRITY — Phase 3 (DEC-02 + DEC-01 + ADR-014)
// ═══════════════════════════════════════════════════════════════════════════

// 12. COMMISSION (V4.13 G21-B14 — Hoa hồng CTV/Sale)
//     ADR-013 (Record khóa bất biến): KHÔNG có @@unique trên ledger để cho phép
//     nhiều dòng CREDIT/REVERSAL cho cùng ctv+worker+month/year (milestones + clawback).
//     ADR-010: Mọi trường tiền BigInt (VND nguyên).
// ═══════════════════════════════════════════════════════════════════════════

/// CommissionPolicy — chính sách hoa hồng (group + version).
/// `calcType`:
///   - PER_HEAD_MILESTONE: thưởng cố định per head theo milestone (vd 500_000 per worker RETAINED_30_DAYS).
///   - PERCENT_OF_REVENUE: % giá trị vòng đời worker (revenue_attribution_vnd) trong kỳ.
/// `value` BigInt — cho PER_HEAD_MILESTONE = số tiền/head; cho PERCENT_OF_REVENUE = số basis points (1 = 0.01%).
/// Versioning: cập nhật policy TẠO ROW MỚI (version++) thay vì UPDATE — ADR-013 ledger tham chiếu version cụ thể.
/// `conditions` Json: { milestones: [{code: 'RETAINED_30_DAYS', days: 30}, ...], requireAssignment: 'ACTIVE', ... }
model CommissionPolicy {
  id            String    @id @default(uuid())
  name          String    // vd 'CTV-2026-Q3-Standard'
  calcType      String    @map("calc_type") // PER_HEAD_MILESTONE | PERCENT_OF_REVENUE
  value         BigInt    @map("value") // BigInt VND nguyên (ADR-010) — ý nghĩa theo calcType
  conditions    Json      @default("{}") @map("conditions") // flexible: milestones, scope, ...
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  version       Int       @default(1) // immutable per id; mỗi lần "update" = tạo row mới
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  ledgerEntries CommissionLedger[]

  @@index([effectiveFrom, effectiveTo])
  @@map("commission_policies")
}

/// CommissionLedger — sổ cái hoa hồng (append-only theo ADR-013).
/// `direction`:
///   - CREDIT: hoa hồng dự kiến/phát sinh (Cộng).
///   - REVERSAL: dòng đảo (clawback) — Trừ khi đã APPROVED/PAID; PENDING chờ kế toán duyệt (DEC-05).
/// `status`: PENDING → APPROVED → PAID. REJECTED chỉ từ PENDING. Không quay lui.
/// `milestone` mã milestone đạt được (vd 'RETAINED_30_DAYS'); dùng để idempotent (cùng policy+worker+month+milestone chỉ tạo 1 CREDIT).
/// `reversalOfId` chỉ REVERSAL: id của dòng CREDIT bị đảo.
/// Idempotency: dùng IdempotencyKey (route POST:/api/admin/commission-ledger/credit) + @@index([ctvId, workerId, month, year, milestone]).
model CommissionLedger {
  id            String    @id @default(uuid())
  ctvId         String    @map("ctv_id")
  workerId      String?   @map("worker_id") // null nếu PERCENT_OF_REVENUE không gắn worker
  assignmentId  String?   @map("assignment_id")
  policyId      String    @map("policy_id")
  milestone     String    @map("milestone") // 'RETAINED_30_DAYS' | ...
  amount        BigInt    @map("amount") // BigInt VND nguyên (ADR-010) — luôn dương
  direction     String    @map("direction") // CREDIT | REVERSAL
  reversalOfId  String?   @map("reversal_of_id") // chỉ REVERSAL
  month         Int       @map("month") // 1..12
  year          Int       @map("year") // 2026
  status        String    @default("PENDING") @map("status") // PENDING | APPROVED | PAID | REJECTED
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  paidAt        DateTime? @map("paid_at")
  rejectedBy    String?   @map("rejected_by")
  rejectedAt    DateTime? @map("rejected_at")
  rejectionReason String? @map("rejection_reason") @db.Text

  policy        CommissionPolicy @relation(fields: [policyId], references: [id])
  reversalOf    CommissionLedger?  @relation("ReversalPair", fields: [reversalOfId], references: [id])
  reversals     CommissionLedger[] @relation("ReversalPair")

  @@index([ctvId, month, year])
  @@index([workerId, month, year])
  @@index([status])
  @@index([ctvId, workerId, month, year, milestone]) // idempotency lookup
  @@map("commission_ledger")
}

/// CommissionDebt — nợ hoa hồng (V4.13 G21-B14 — Nợ hoa hồng & netting).
/// Khi REVERSAL APPROVED vượt số dư khả dụng → tạo Debt. CREDIT APPROVED sẽ cấn trừ Debt trước khi thành PAID.
/// `status`: OPEN → PARTIAL → CLEARED. Không xóa debt khi CLEARED (audit).
model CommissionDebt {
  id          String    @id @default(uuid())
  ctvId       String    @map("ctv_id")
  originLedgerId String? @map("origin_ledger_id") // REVERSAL sinh ra debt này
  amountVnd   BigInt    @map("amount_vnd") // BigInt VND nguyên (ADR-010) — số tiền nợ ban đầu
  remainingVnd BigInt   @map("remaining_vnd") // số nợ còn lại (giảm khi netting)
  status      String    @default("OPEN") @map("status") // OPEN | PARTIAL | CLEARED
  reason      String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  clearedAt   DateTime? @map("cleared_at")

  @@index([ctvId, status])
  @@map("commission_debts")
}

/// CtvWithdrawalRequest — yêu cầu rút tiền của CTV (M11).
/// Thay thế file JSON tạm (`data/withdrawals.json`) để tương thích Vercel Serverless.
/// Số tiền luôn dương, BigInt VND nguyên (ADR-010).
/// `status`: PENDING (mặc định) → APPROVED | REJECTED.
model CtvWithdrawalRequest {
  id          String   @id @default(uuid())
  ctvId       String   @map("ctv_id")
  amountVnd   BigInt   @map("amount_vnd")
  bankAccount String   @map("bank_account")
  bankName    String   @map("bank_name")
  status      String   @default("PENDING") @map("status") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ctvId, status])
  @@index([status, createdAt])
  @@map("ctv_withdrawal_requests")
}

/// Idempotency keys cho POST/PATCH/DELETE nhạy cảm.
/// Scope UNIQUE (actorId, route, key) — đảm bảo retry trong TTL trả đúng kết quả lần đầu.
/// TTL 24h (giữ hành vi hiện tại của ticket.service round 1).
/// `response` lưu JSON kết quả lần đầu để replay khi client retry.
model IdempotencyKey {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  route       String   // vd 'POST:/api/tickets', 'POST:/api/tickets/{id}/approve'
  key         String   // x-idempotency-key
  requestHash String   @map("request_hash") // SHA-256 của body để phát hiện client sai key
  response    Json     @default("{}")
  statusCode  Int      @default(200) @map("status_code")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([actorId, route, key], name: "uq_idempotency_keys_scope")
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Outbox cho side-effect (notification + future email/sms/zalo).
/// Enqueue trong cùng $transaction với state change → rollback = không event.
/// Drain in-process sau commit + cron daily lưới an toàn (DEC-01, D16 (b)).
model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    @map("event_type") // vd 'TicketNotification'
  aggregateId String    @map("aggregate_id") // ticketId, statementId, ...
  payload     Json      @default("{}")
  status      String    @default("PENDING") // 'PENDING' | 'PROCESSED' | 'FAILED'
  retryCount  Int       @default(0) @map("retry_count")
  availableAt DateTime  @default(now()) @map("available_at") // cho delayed retry
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, availableAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

model PortalTimesheet {
  id             String   @id @default(uuid())
  employeeCode   String   @map("employee_code")
  fullName       String   @map("full_name")
  project        String
  
  periodMonth    Int?     @map("period_month")
  periodYear     Int?     @map("period_year")
  
  totalWorkDays  Decimal  @default(0) @map("total_work_days") @db.Decimal(5, 2)
  otHours        Decimal  @default(0) @map("ot_hours") @db.Decimal(5, 2)
  absentDays     Decimal  @default(0) @map("absent_days") @db.Decimal(5, 2)
  
  dailyData      Json?    @map("daily_data") 
  payrollData    Json?    @map("payroll_data")
  totalIncome    Decimal? @default(0) @map("total_income") @db.Decimal(12, 2)
  
  createdAt      DateTime @default(now()) @map("created_at")
  
  @@index([employeeCode])
  @@index([employeeCode, project, periodMonth, periodYear], name: "idx_timesheets_lookup")
  // STEP-08 / RQ-09: chống bơm trùng công theo (NV, dự án, kỳ)
  @@unique([employeeCode, project, periodMonth, periodYear], name: "uq_portal_timesheets_period")
  @@map("portal_timesheets")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint], name: "userId_endpoint")
  @@index([userId])
  @@map("push_subscriptions")
}

