# ============================================================================
# HRP Web App - DEV environment
# DB phụ: Neon Branch `dev` (clone từ production)
# Xem: docs/setup_db_phu.md
# Ngày tạo: 2026-08-19
# ============================================================================

APP_ENV=dev

# ============================================================================
# Prisma / database — Neon Branch `dev`
# Paste connection string từ Neon Console vào đây
# ============================================================================
DATABASE_URL=postgresql://neondb_owner:npg_E0eqUu7aHtpI@ep-shy-tree-az32as2c.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# Auth (Phase 1 bcc-fence) — JWT secret >= 32 ký tự
# Copy từ .env hiện tại (nếu cần test auth giống prod)
# ============================================================================
JWT_SECRET=__PASTE_JWT_SECRET_HERE__

# ============================================================================
# Seed tài khoản login (bcc-fence) — phone + password
# Copy từ .env hiện tại
# ============================================================================
ADMIN_PHONE=__PASTE_ADMIN_PHONE_HERE__
ADMIN_PASSWORD=__PASTE_ADMIN_PASSWORD_HERE__
HR_PHONE=__PASTE_HR_PHONE_HERE__
HR_PASSWORD=__PASTE_HR_PASSWORD_HERE__

# ============================================================================
# NEXTAUTH (nếu web app dùng)
# ============================================================================
NEXTAUTH_DATABASE_URL=__PASTE_NEON_DEV_BRANCH_URL_HERE__